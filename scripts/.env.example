# Copy this file to .env and fill in your Base44 App ID.
# Find it in the Base44 dashboard → your project → Settings → App ID.
BASE44_APP_ID=your-base44-app-id-here

# For find-businesses.js — Google Places API (New) key with billing enabled.
# console.cloud.google.com → enable "Places API (New)" → create an API key.
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# For send-alumni-email.js — Resend transactional email.
# 1. Sign up at resend.com, add & verify your sending domain (DNS records).
# 2. Create an API key at resend.com/api-keys.
RESEND_API_KEY=re_your_resend_api_key_here
# Must use a domain you verified in Resend. Format: "Display Name <addr@domain>".
FROM_EMAIL=TKE Epsilon-Alpha <alumni@yourdomain.org>
# Where alumni replies should land (optional but recommended).
REPLY_TO=alumni@yourdomain.org
# Optional hosted unsubscribe page; if omitted, a mailto-unsubscribe is used.
UNSUBSCRIBE_URL=
