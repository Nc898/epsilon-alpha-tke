{
  "name": "Member",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "photo": {
      "type": "string",
      "description": "URL to member's headshot/photo"
    },
    "position": {
      "type": "string",
      "description": "e.g. President, Vice President, Treasurer, etc. Leave blank for general member."
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "major": {
      "type": "string"
    },
    "graduation_year": {
      "type": "number"
    },
    "bio": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 99,
      "description": "Lower numbers appear first. Use 1-10 for exec board, 99 for general members."
    }
  },
  "required": ["name", "email"]
}
